# Root
/*

!/.cargo/
!/.github/
!/crates/
!/deploy/

# 提交 README 引用的 Chat 技术书与工程技能配置，其余文档默认仅保留本地。
!/docs/
/docs/*
!/docs/burncloud-chat-home-technical-book.md
!/docs/agents/
/docs/agents/*
!/docs/agents/issue-tracker.md
!/docs/agents/triage-labels.md
!/docs/agents/domain.md
!/docs/specs/
/docs/specs/*
!/docs/specs/local-route-attachment.md
!/docs/adr/
/docs/adr/*
!/docs/specs/
/docs/specs/*
!/docs/specs/local-route-attachment.md
!/docs/adr/0001-local-route-attachment-scope.md
!/src/

!/AGENTS.md
!/GLOSSARY.md
!/.env.example
!/.gitattributes
!/.gitignore
!/Cargo.toml
!/README.md
!/clippy.toml
!/deny.toml

!/.cargo/**
!/.github/**
!/crates/**
!/deploy/**
!/src/**

# Rust build artifacts
/target/
crates/interfaces/tests/target/
**/*.rs.bk
*.pdb
Cargo.lock

# Tailwind CSS standalone CLI (downloaded locally, invoked by build.rs)
# See crates/interfaces/client/build.rs — contributors download the binary to this path.
/crates/interfaces/client/tailwindcss
/crates/interfaces/client/tailwindcss.exe

# Generated by build.rs from tailwind.config.js + input.css; never commit.
/crates/interfaces/client/src/assets/tailwind.css

# Python
*.pyc
__pycache__

# ZIP files
*.zip
*.exe
*.tgz
*.tar.gz
*.tgz

# Test output
/crates/interfaces/tests/tests/ui/*.jpeg
playwright-report
test-results

# Download test
*.iso
*.aria2

# IDEs
.claude
.vscode
.idea/
*.swp
*.swo
*~

# Logs
*.log
nohup*

# Runtime data
pids
*.pid
*.seed
*.pid.lock


# Dependency directories
node_modules

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Black-box test evidence artifacts (real API responses, not for version control)
evidence
.gstack
.gitnexus
